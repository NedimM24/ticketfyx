<!DOCTYPE html>
<html lang="en">
<head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>TicketFyx</title>
        <link rel="stylesheet" href="/css/styles.css">
        
</head>
<body>
        <main>
                <%- include("partials/header.ejs") %>

                <!-- if the user is a worker, they can click to become a dev
                will move this into header eventtually -->

                <% if(user.role === 'worker'){%>
                        <a href="/devRegister">Become a dev</a>
                <% } %>

                <a href="/newTicket">Create a new ticket </a>
                
                <h1>hey <%= user.email%></h1>
                <h2>You are a <%= user.role%></h2>
                

                <h1>Tickets</h1>
                <% tickets.forEach(function(ticket) {%>
                        <div class="ticket-container">
                                <a class="ticket-link" href="/ticketPage/<%= ticket.id%>">
                                        <div class="ticket">

                                                <p><%= ticket.status%></p>
                                                
                                                <div class="title-desc">
                                                        <b class="ticket-title"><%= ticket.title%></b>
                                                        <p><%= ticket.description%></p>
                                                </div>
                                                
                                                <p class="home-dev"><%= ticket.assigned_developer_email ?? "Unassigned"%></p>
                                        </div> 
                                </a>
                        </div>
                <% }) %>
                <%- include("partials/footer.ejs") %>
        </main>
</body>
</html>