<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
     <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <body>
    <%- include("partials/errors.ejs") %>
     <img class="login-logo" src="/css/images/ticketfyxlogo.png" alt="TicketFyx logo">
    <form class="login-page" action="/register" method="post">

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required minlength="3" maxlength="254">

        <label for="password">Password:</label>
        <input type="password" id="password" name="password" required minlength="8" maxlength="128">

        <label for="confirmPassword">Confrim password:</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8" maxlength="128">

        <button class="btn login-btn" type="submit">Create Account</button>

        <p>Already have an account? <a href="/login">Login</a></p>

    </form>
     
     <footer class="footer">
    
    <p>A tracking and collaboration tool</p>
    <p>Built by Nedim Mulahusic</p>
    <p>© 2026 TicketFyx</p>
    </footer>

</body>
    
</body>
</html>