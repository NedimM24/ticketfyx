<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TicketFyx</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  

<body>
    <main>
          <%- include("partials/header.ejs") %>
        <div class="ticketpage-container">

                <div class="clickedTicket">
                    <h4><%= clickedTicket.title%></h4>
                    <p><%= clickedTicket.description%></p>
                    <p><%= clickedTicket.status%></p>
                    <p><%= clickedTicket.priority%></p>
                    <p><%= clickedTicket.creator_email%></p>
                    <p><%= clickedTicket.ticket_creation_date%></p>
                    <p><%= clickedTicket.assigned_developer%></p>
                </div> 

                <div class="comments">
                    <h5>comments</h5>

                    <!---PRINT COMMENTS HERE -->
                    <%- include("partials/errors.ejs") %>
                    <form action="/comment/<%= clickedTicket.id%>" method="post">
                        <label for="comment"></label>
                        <input type="text" name="comment" id="comment"
                        placeholder="write comment here" required>

                        <button type="submit">Send</button>

                    </form>
                </div>
        </div>
    </main>
    <%- include("partials/footer.ejs") %>
</body>
</body>
</html>