<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TicketFyx</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=BBH+Bartle&family=Bebas+Neue&family=Manrope:wght@200..800&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Oswald:wght@200..700&family=Pixelify+Sans:wght@400..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
</head>
<body>
  

<body>
    <main>
        <div class="ticket-parent">
            <%- include("partials/header.ejs") %>
           <div class="ticket-header">
                <p class="ticket-header-title">
                    <b><%= clickedTicket.title%></b>
                </p>

                <div class="status-priority">
                    <p class="<%=clickedTicket.priority%>">
                        <%= clickedTicket.status%>
                    </p>

                    <p class="ct-priority">
                        <%=clickedTicket.priority%> priority
                    </p>
                </div>
            </div>
        <div class="ticketpage-container">

                <div class="clickedTicket">
                 
                    <div class="left">
                     <b>Description </b> 
                     <p><%= clickedTicket.description%></p>
                    </div>
                    
                    <div class="right">
                        <%if(user.role === "admin" || user.role === "developer") {%>
                            <form class="status dropdown" 
                                action="/ticket/<%=clickedTicket.id%>/status" 
                                method="post">

                                <label for="status">Update Status: </label>
                                <!--'open', 'in progress', 'testing', 'resolved' -->
                                <select name="status" id="status" onchange="this.form.submit()">
                                    <option value="open" 
                                        <%= clickedTicket.status === "open" ? "selected" : ""%> 
                                        >Open
                                    </option>

                                    <option value="in progress" 
                                        <%= clickedTicket.status === "in progress" ? "selected" : ""%> 
                                        >In Progress
                                    </option>

                                    <option value="testing" 
                                        <%= clickedTicket.status === "testing" ? "selected" : ""%> 
                                        >Testing
                                    </option>

                                    <option value="resolved" 
                                        <%= clickedTicket.status === "resolved" ? "selected" : ""%> 
                                        >Resolved
                                    </option>
                                    
                                </select>
                            </form>
                        <%} else {%>
                            <p>✅ <b>Status: </b><%= clickedTicket.status%></p>
                        <%}%>  
                        
                        <!-- 'low', 'medium', 'high', 'critical'-->
                        <%if(user.role === "admin" || user.role === "developer") {%>
                            <form class="priority dropdown" 
                                action="/ticket/<%=clickedTicket.id%>/priority" 
                                method="post">

                                <label for="priority">Update Priority: </label>

                                <select name="priority" id="priority" onchange="this.form.submit()">
                                    <option value="low" 
                                        <%= clickedTicket.priority === "low" ? "selected" : ""%> 
                                        >Low
                                    </option>

                                    <option value="medium" 
                                        <%= clickedTicket.priority === "medium" ? "selected" : ""%> 
                                        >Medium
                                    </option>

                                    <option value="high" 
                                        <%= clickedTicket.priority === "high" ? "selected" : ""%> 
                                        >High
                                    </option>

                                    <option value="critical" 
                                        <%= clickedTicket.priority === "critical" ? "selected" : ""%> 
                                        >Critical
                                    </option>
                                    
                                </select>
                            </form>
                        <%} else {%>
                            <p>🚩 <b>Priority: </b><%= clickedTicket.priority%></p>
                        <%}%>    

                        <p>👤 <b>Username: </b><%= clickedTicket.creator_email%></p>
                        <p>📅 <b>Date Created: </b><%= clickedTicket.ticket_creation_date%></p>
                        <p>🤝 <b>Assigned Dev: </b><%= clickedTicket.assigned_developer_email ?? "Unnasigned"%></p>

                        <!-- dev loop -->
                        <%if(user.role === "admin" ) {%>
                            <form class="dev dropdown" 
                            action="/ticketPage/<%=clickedTicket.id%>/assign" method="post"
                            >

                            <select name="devId" id="devId" onchange="this.form.submit()">
                                <option value="placeholer" selected>Assign New Dev</option>
                                <%devs.forEach((dev) => {%>
                                    <option value="<%=dev.id%>"><%=dev.email%></option>
                                <%})%>
                            </select>
                                
                            </form>
                        <%}%>  

                        <!-- IF THE USER IS AN ADMIN, THEY HAVE A DELETE TICKET BUTTON -->
                        <%if(user.role === "admin" ) {%>
                            <form class="delete-ticket" action="/ticketPage/<%=clickedTicket.id%>/delete" method="post">
                                <button class="delete-ticket-btn" type="submit">Delete Ticket</button>
                            </form>
                        <%}%>  
                    </div> 
                </div>
        </div>
         <div class="comments">
                    <h5 class="comment-title">comments</h5>

                    <!---PRINT COMMENTS HERE -->

                    <%comments.forEach((comment) => {%>
                        <div class="comment">
                            <p> <b><%=comment.creator_email%></b></p>
                            <p><%=comment.comment%></p>
                            <p><%=comment.comment_creation_date%></p>

                             <!-- IF THE USER IS AN ADMIN, THEY HAVE A DELETE COMMENT BUTTON -->
                            <%if(user.role === "admin" ) {%>
                                <form  action="/ticketPage/<%=clickedTicket.id%>/comments/<%=comment.id%>/delete" method="post">
                                    <button class="delete-comment" type="submit">Delete Comment</button>
                                </form>
                            <%}%>  

                        </div>
                    <%})%>

                    <%- include("partials/errors.ejs") %>
                    <form class="comment-form" action="/comment/<%= clickedTicket.id%>" method="post">
                        <label for="comment"></label>
                        <input class="comment-input" type="text" name="comment" id="comment"
                        placeholder="write comment here" required>

                        <button class="dev-btn" type="submit">Send</button>

                    </form>
            </div>
        </div>
    </main>
    <%- include("partials/footer.ejs") %>
</body>
</body>
</html>